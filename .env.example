# Copy to .env.local. Supply values through your service secret settings.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_URL=
# Controlled migration connection, never needed by application startup.
DATABASE_URL_UNPOOLED=
# Local preview: EMAIL_DELIVERY=local with npm run dev and a loopback auth URL.
# Production: EMAIL_DELIVERY=resend with real delivery credentials.
EMAIL_DELIVERY=resend
RESEND_API_KEY=
EMAIL_FROM=
# Only on Vercel after its forwarding-header trust boundary is verified.
TRUST_VERCEL_PROXY=false

# Server-only live generation, practice and feedback. Agreed model default, no fallback.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
