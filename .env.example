# Copy to .env.local. Supply values through your service secret settings.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_URL=
# Controlled migration connection, never needed by application startup.
DATABASE_URL_UNPOOLED=
RESEND_API_KEY=
EMAIL_FROM=
# Only on Vercel after its forwarding-header trust boundary is verified.
TRUST_VERCEL_PROXY=false

# Required for live course-plan generation. No default or model fallback.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
